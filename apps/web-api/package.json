{
  "name": "@musefold/web-api",
  "version": "0.0.0-internal",
  "description": "Musefold v1.1 Web API, OAuth and Cloud MCP host",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/bin.ts",
    "start": "tsx src/bin.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:integration": "RUN_DATABASE_TESTS=true vitest run src/__tests__/database.integration.test.ts",
    "db:migrate": "node-pg-migrate -m migrations --database-url-var DATABASE_URL --migrations-table pgmigrations up",
    "db:rollback": "node-pg-migrate -m migrations --database-url-var DATABASE_URL --migrations-table pgmigrations down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/swagger": "9.6.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@musefold/contracts": "*",
    "@musefold/domain": "*",
    "@musefold/new-api-client": "*",
    "@musefold/server-crypto": "*",
    "ajv": "^8.20.0",
    "fastify": "5.12.0",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.5",
    "node-pg-migrate": "9.0.0",
    "oidc-provider": "~9.11.3",
    "pg": "8.23.0",
    "tsx": "4.20.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/oidc-provider": "^9.11.1",
    "@types/pg": "8.15.5",
    "graphile-worker": "0.17.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
