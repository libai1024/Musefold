{
  "name": "@musefold/web",
  "version": "0.0.0-internal",
  "description": "Musefold Web v1.1.1 personal generation and cloud prompt surface",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixtures": "vite --host 127.0.0.1 --mode fixtures",
    "build": "vite build",
    "check:production": "npm run build && node scripts/check-production-build.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@musefold/cloud-client": "*",
    "@musefold/contracts": "*",
    "@musefold/domain": "*",
    "@musefold/product-ui": "*",
    "@musefold/ui": "*",
    "@tanstack/react-query": "^5.101.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
