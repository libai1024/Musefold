PUBLIC_ORIGIN=http://127.0.0.1:60160
HOST=127.0.0.1
PORT=60160
LOG_LEVEL=debug
OPENAPI_ENABLED=true

# New API relay. The Web API never sends these upstream tokens to the browser.
NEW_API_BASE_URL=https://zhaozhaoyue.top
SESSION_COOKIE_NAME=mf_session
SESSION_ENCRYPTION_KEY=change-this-to-a-32-byte-random-secret
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Production must provide a persistent signing JWKS JSON with private keys and kid.
OAUTH_JWKS_JSON=
MCP_RESOURCE_URL=http://127.0.0.1:60160/api/musefold/mcp

# Use the migration role only for migrations.
DATABASE_URL=postgres://musefold_migration:musefold_migration@127.0.0.1:55432/musefold
WEB_API_DATABASE_URL=postgres://musefold_app:musefold_app@127.0.0.1:55432/musefold
WORKER_DATABASE_URL=postgres://musefold_worker:musefold_worker@127.0.0.1:55432/musefold

S3_ENDPOINT=http://127.0.0.1:59000
# Public origin used only for browser-readable signed asset URLs.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=musefold-local
S3_ACCESS_KEY_ID=musefold_local
S3_SECRET_ACCESS_KEY=musefold_local_secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_SIGNED_URL_TTL_SECONDS=600
