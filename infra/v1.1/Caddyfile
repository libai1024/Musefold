{
	# Keep the IP certificate for clients that omit SNI.
	default_sni 45.207.211.136
}

(v11_api) {
	reverse_proxy v11-web-api:60160 {
		lb_try_duration 8s
		lb_try_interval 250ms
	}
}

45.207.211.136 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	reverse_proxy new-api:3000
}

zhaozhaoyue.top, www.zhaozhaoyue.top {
	redir /Musefold /Musefold/ permanent

	handle /health/* {
		import v11_api
	}

	handle /api/musefold/mcp {
		import v11_api
	}

	handle /api/musefold/v1/* {
		import v11_api
	}

	handle /.well-known/oauth-protected-resource* {
		import v11_api
	}

	handle /.well-known/oauth-authorization-server {
		import v11_api
	}

	handle /musefold-local/* {
		reverse_proxy v11-minio:9000
	}

	handle_path /Musefold/api/* {
		reverse_proxy download-stats:8080
	}

	handle /Musefold/app/* {
		root * /srv/musefold-site
		try_files {path} /Musefold/app/index.html
		header Cache-Control "no-cache"
		file_server
	}

	handle /Musefold/* {
		root * /srv/musefold-site
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy new-api:3000
	}
}
