# Import within the existing domain block; retain all legacy handlers below it.
# No domain-root login, API or OAuth discovery path is claimed by this application.
(musefold_v25) {
    @v25_alias {
        host www.zhaozhaoyue.top
        path /Musefold/v25 /Musefold/v25/*
    }
    redir @v25_alias https://zhaozhaoyue.top{uri} 308
    handle /.well-known/oauth-protected-resource/Musefold/v25/mcp {
        reverse_proxy musefold-v25-api:8787
    }
    handle /.well-known/oauth-authorization-server/Musefold/v25/api/auth {
        reverse_proxy musefold-v25-api:8787
    }
    handle /.well-known/openid-configuration/Musefold/v25/api/auth {
        reverse_proxy musefold-v25-api:8787
    }
    handle /Musefold/v25 {
        reverse_proxy musefold-v25-web:3000
    }
    handle /Musefold/v25/api/* {
        reverse_proxy musefold-v25-api:8787
    }
    handle /Musefold/v25/mcp {
        reverse_proxy musefold-v25-api:8787
    }
    handle /Musefold/v25/healthz {
        reverse_proxy musefold-v25-api:8787
    }
    handle /Musefold/v25/* {
        reverse_proxy musefold-v25-web:3000
    }
    # S3 signatures include the exact bucket path: never strip or rewrite it.
    @v25_objects path /musefold-v25 /musefold-v25/*
    handle @v25_objects {
        reverse_proxy musefold-v25-objects:9000
    }
}
