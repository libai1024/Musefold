{
  "name": "musefold-app",
  "version": "0.5.0-dev.2",
  "description": "Forge your image prompts — 跨平台生图提示词管理桌面 App",
  "main": "./out/main/index.js",
  "author": "Musefold",
  "contributors": [
    "昭昭月科技有限公司"
  ],
  "license": "MIT",
  "type": "module",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "skill:check": "node scripts/check-skill-update.mjs",
    "skill:check:ci": "node scripts/check-skill-update.mjs --ci",
    "dev": "electron-vite dev",
    "dev:stop": "node scripts/stop-dev-processes.mjs",
    "dev:web": "npm run dev --workspace @musefold/web",
    "dev:web:fixtures": "npm run dev:fixtures --workspace @musefold/web",
    "dev:web-api": "npm run dev --workspace @musefold/web-api",
    "dev:generation-worker": "npm run dev --workspace @musefold/generation-worker",
    "dev:v1.1:infra": "docker compose -f infra/v1.1/compose.yaml up -d",
    "dev:v1.1:infra:down": "docker compose -f infra/v1.1/compose.yaml down",
    "build": "electron-vite build",
    "build:web": "npm run build --workspace @musefold/web",
    "package": "electron-vite build && node scripts/build-cli.mjs && node scripts/run-builder.mjs",
    "package:mac": "electron-vite build && node scripts/build-cli.mjs && node scripts/run-builder.mjs --mac --config.electronDist=node_modules/electron/dist",
    "package:mac:adhoc": "electron-vite build && node scripts/build-cli.mjs && node scripts/run-builder.mjs --mac --arm64 --dir --config.electronDist=node_modules/electron/dist && node scripts/sign-macos-adhoc.mjs && node scripts/run-builder.mjs --mac dmg zip --arm64 --prepackaged release/mac-arm64/Musefold.app",
    "package:win": "electron-vite build && node scripts/build-cli.mjs && node scripts/run-builder.mjs --win",
    "typecheck": "tsc -b",
    "typecheck:v1.1": "tsc -b packages/contracts packages/domain packages/new-api-client packages/cloud-client packages/server-crypto packages/ui packages/product-ui apps/web apps/web-api apps/generation-worker",
    "typecheck:node": "tsc -b tsconfig.node.json",
    "typecheck:web": "tsc -b tsconfig.web.json",
    "rebuild": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:v1.1": "vitest run packages/contracts packages/domain && npm run test --workspace @musefold/new-api-client && npm run test --workspace @musefold/cloud-client && npm run test --workspace @musefold/ui && npm run test --workspace @musefold/product-ui && npm run test --workspace @musefold/web && npm run test --workspace @musefold/web-api && npm run test --workspace @musefold/generation-worker",
    "test:web-api": "npm run test --workspace @musefold/web-api",
    "test:generation-worker": "npm run test --workspace @musefold/generation-worker",
    "test:worker": "npm run test:generation-worker",
    "test:cloud-mcp": "npm run test --workspace @musefold/web-api -- src/modules/mcp",
    "test:e2e:web": "npm run test:e2e --workspace @musefold/web",
    "test:visual:shared": "node scripts/compare-shared-ui-visuals.mjs",
    "check:ui-boundaries": "node scripts/check-shared-ui-boundaries.mjs",
    "check:boundaries": "depcruise --config tooling/dependency-cruiser.cjs --ignore-known tooling/dependency-cruiser-known-violations.json src electron shared packages apps",
    "db:migrate:v1.1": "npm run db:migrate --workspace @musefold/web-api",
    "db:rollback:v1.1": "npm run db:rollback --workspace @musefold/web-api",
    "queue:migrate:v1.1": "npm run queue:migrate --workspace @musefold/generation-worker",
    "test:integration:v1.1": "node scripts/test-v1.1-integration.mjs",
    "test:staging:v1.1": "node scripts/test-v1.1-staging.mjs",
    "test:staging:mcp-sdk": "node scripts/test-v1.1-mcp-staging.mjs",
    "test:staging:mcp-full": "node scripts/test-v1.1-mcp-full.mjs",
    "openapi:check": "node scripts/check-v1.1-openapi.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:web",
    "check:v1.1": "npm run check:ui-boundaries && npm run typecheck:v1.1 && npm run test:v1.1 && npm run check:production --workspace @musefold/web",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:status": "node scripts/release-gate-status.mjs",
    "release:evidence": "node scripts/release-gate-evidence.mjs",
    "release:ci:evidence": "node scripts/release-ci-evidence.mjs",
    "release:windows:hosted": "node scripts/release-windows-hosted-evidence.mjs",
    "release:macos:signing": "node scripts/release-macos-signing-evidence.mjs",
    "release:signing:precheck": "node scripts/release-signing-precheck.mjs",
    "release:windows:target": "node scripts/release-windows-target-checklist.mjs",
    "test:e2e": "npm run build && pytest tests/e2e -q",
    "test:e2e:verify": "npm run build && node preview/mcp-verify-ipc.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle:manifest": "node packages/update-protocol/src/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.27",
    "@dnd-kit/core": "^6.3.1",
    "@gsap/react": "^2.1.2",
    "@musefold/cloud-client": "*",
    "@musefold/contracts": "*",
    "@musefold/update-protocol": "*",
    "@musefold/product-ui": "*",
    "@musefold/ui": "*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@tanstack/react-virtual": "^3.14.9",
    "ai": "7.0.58",
    "archiver": "7.0.1",
    "archiver-utils": "5.0.2",
    "better-sqlite3": "13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff-match-patch": "^1.0.5",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "fuse.js": "^7.0.0",
    "gpt-tokenizer": "^2.5.0",
    "gsap": "^3.15.0",
    "immer": "^11.1.15",
    "lucide-react": "^1.28.0",
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "react-arborist": "^3.16.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "tailwind-merge": "^2.5.0",
    "ulid": "^3.0.1",
    "yaml": "^2.9.0",
    "yauzl": "2.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^17.4.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-driver": "^0.3.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.11",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-xml-parser": "5.7.2",
    "nanoid": "3.3.18",
    "uuid": "11.1.1",
    "openai": {
      "zod": "$zod"
    }
  }
}
