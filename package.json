{
  "name": "@musefold/workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "cd apps/desktop && electron-vite dev --config electron.vite.config.ts",
    "dev:stop": "node scripts/stop-dev-processes.mjs",
    "dev:web": "pnpm --filter @musefold/web run dev",
    "dev:web:fixtures": "pnpm --filter @musefold/web run dev:fixtures",
    "dev:web-api": "pnpm --filter @musefold/web-api run dev",
    "dev:worker": "pnpm --filter @musefold/generation-worker run dev",
    "dev:infra": "docker compose -f infra/v1.1/compose.yaml up -d",
    "dev:infra:down": "docker compose -f infra/v1.1/compose.yaml down",
    "build": "cd apps/desktop && electron-vite build --config electron.vite.config.ts",
    "build:web": "pnpm --filter @musefold/web run build",
    "package": "pnpm run build && node scripts/build-cli.mjs && node scripts/run-builder.mjs",
    "package:mac": "pnpm run build && node scripts/build-cli.mjs && node scripts/run-builder.mjs --mac --config.electronDist=../../node_modules/electron/dist",
    "package:mac:adhoc": "pnpm run build && node scripts/build-cli.mjs && node scripts/run-builder.mjs --mac --arm64 --dir --config.electronDist=../../node_modules/electron/dist && node scripts/sign-macos-adhoc.mjs && node scripts/run-builder.mjs --mac dmg zip --arm64 --prepackaged ../../release/mac-arm64/Musefold.app",
    "package:win": "pnpm run build && node scripts/build-cli.mjs && node scripts/run-builder.mjs --win",
    "rebuild": "pnpm --filter musefold-app run postinstall",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && pytest tests/e2e -q",
    "test:e2e:web": "pnpm --filter @musefold/web run test:e2e",
    "test:e2e:verify": "pnpm run build && node preview/mcp-verify-ipc.mjs",
    "test:integration": "node scripts/test-v1.1-integration.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:boundaries": "depcruise --config tooling/dependency-cruiser.cjs --ignore-known tooling/dependency-cruiser-known-violations.json packages apps",
    "check": "turbo run lint typecheck test build check:boundaries && pnpm run build:web",
    "db:migrate": "pnpm --filter @musefold/web-api run db:migrate",
    "db:rollback": "pnpm --filter @musefold/web-api run db:rollback",
    "queue:migrate": "pnpm --filter @musefold/generation-worker run queue:migrate",
    "derive:min-shell": "node scripts/derive-min-shell-version.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "deploy:prod": "node scripts/deploy/run.mjs",
    "deploy:rollback": "node scripts/deploy/rollback.mjs",
    "deploy:desktop": "node scripts/deploy/publish-desktop.mjs",
    "bundle:manifest": "node packages/update-protocol/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@lhci/cli": "^0.15.1",
    "@musefold/core": "workspace:*",
    "@musefold/desktop-contracts": "workspace:*",
    "@musefold/domain": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^17.4.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-driver": "^0.3.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
