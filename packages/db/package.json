{
  "name": "@musefold/db",
  "version": "0.0.0-internal",
  "description": "Musefold v2.5 PostgreSQL Drizzle schema 与迁移(api 与 worker 共享)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
