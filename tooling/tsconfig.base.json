{
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "disableSourceOfProjectReferenceRedirect": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"],
      "@electron/*": ["apps/desktop/electron/*"],
      "@renderer/*": ["apps/desktop/src/*"],
      "@musefold/core": ["packages/core/src/index.ts"],
      "@musefold/core/*": ["packages/core/src/*"],
      "@musefold/automation-server": ["packages/automation-server/src/index.ts"],
      "@musefold/automation-server/*": ["packages/automation-server/src/*"],
      "@musefold/client": ["packages/client/src/index.ts"],
      "@musefold/client/*": ["packages/client/src/*"],
      "@musefold/cli": ["packages/cli/src/index.ts"],
      "@musefold/cli/*": ["packages/cli/src/*"],
      "@musefold/mcp": ["packages/mcp/src/index.ts"],
      "@musefold/mcp/*": ["packages/mcp/src/*"],
      "@musefold/contracts": ["packages/contracts/src/index.ts"],
      "@musefold/contracts/*": ["packages/contracts/src/*"],
      "@musefold/domain": ["packages/domain/src/index.ts"],
      "@musefold/domain/*": ["packages/domain/src/*"],
      "@musefold/ui": ["packages/ui/src/index.ts"],
      "@musefold/ui/*": ["packages/ui/src/*"],
      "@musefold/product-ui": ["packages/product-ui/src/index.ts"],
      "@musefold/product-ui/*": ["packages/product-ui/src/*"],
      "@musefold/cloud-client": ["packages/cloud-client/src/index.ts"],
      "@musefold/new-api-client": ["packages/new-api-client/src/index.ts"],
      "@musefold/server-crypto": ["packages/server-crypto/src/index.ts"],
      "@musefold/update-protocol": ["packages/update-protocol/src/index.ts"]
    }
  }
}
