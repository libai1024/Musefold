{
  "$schema": "https://turborepo.dev/schema.json",
  // 远程缓存走 Turborepo 默认:环境里设 TURBO_TOKEN / TURBO_TEAM 即启用,凭据不进本文件。
  // Electron 打包(package / package:mac / package:win)刻意不是 turbo 任务。
  "globalDependencies": [
    "tsconfig*.json",
    "apps/desktop/tsconfig*.json",
    "tooling/tsconfig.base.json",
    "pnpm-workspace.yaml",
    "biome.json"
  ],
  "globalEnv": ["NODE_VERSION"],
  // PORT 只是本地预览端口(vite.preview.config.ts / E2E),不影响构建产物哈希。
  "globalPassThroughEnv": [
    "PORT",
    "MUSEFOLD_LIVE_E2E",
    "MUSEFOLD_LIVE_GENERATION",
    "MUSEFOLD_LIVE_ACCOUNT_GENERATION",
    "MUSEFOLD_LIVE_RESUME_RUN_ID",
    "MUSEFOLD_LIVE_RESUME_AGENT_ID",
    "MUSEFOLD_LIVE_RESUME_STAGE",
    "MUSEFOLD_LIVE_RESUME_FORMAL_RUN_ID",
    "MUSEFOLD_LIVE_RESUME_FORMAL_GENERATION_ID",
    "MUSEFOLD_E2E_ACCOUNT_IMAGE_MODEL",
    "MUSEFOLD_E2E_IMAGE_BASE_URL",
    "MUSEFOLD_E2E_IMAGE_MODEL",
    "MUSEFOLD_PACKAGE_ARCH",
    "MUSEFOLD_PACKAGE_PATH",
    "MUSEFOLD_PACKAGE_REQUIRED"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".tsout/**"],
      "with": ["//#typecheck"]
    },
    "@musefold/web-next#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@musefold/mcp#typecheck": {
      "dependsOn": [
        "@musefold/client#typecheck",
        "@musefold/core#typecheck",
        "@musefold/automation-server#typecheck"
      ],
      "outputs": [".tsout/**"]
    },
    "//#typecheck": {
      "dependsOn": [
        "@musefold/managed-fs#typecheck",
        "@musefold/core#typecheck",
        "@musefold/desktop-contracts#typecheck",
        "@musefold/automation-server#typecheck",
        "@musefold/cli#typecheck",
        "@musefold/mcp#typecheck"
      ],
      "outputs": [".tsout/**", "packages/*/.tsout/**", "apps/*/.tsout/**"],
      "inputs": [
        "package.json",
        "tsconfig*.json",
        "apps/desktop/tsconfig*.json",
        "tooling/tsconfig.base.json",
        "docs/v2.5/V25-EVIDENCE-MANIFEST.json",
        "docs/v2.5/V25-MIGRATION-CARDS.md",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "tests/v25/**",
        "tests/repo/**",
        "!tests/v25/.results/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "test": {
      "env": [
        "CI",
        "MUSEFOLD_TVT_KEY",
        "RUN_DATABASE_TESTS",
        "DOCKER_HOST",
        "TESTCONTAINERS_HOST_OVERRIDE"
      ]
    },
    "@musefold/managed-fs#build": {
      "cache": false,
      "outputs": ["build/Release/managed_fs.node", "build/native-input.json"]
    },
    "//#test": {
      "dependsOn": ["@musefold/managed-fs#build"],
      "env": [
        "CI",
        "MUSEFOLD_TVT_KEY",
        "RUN_DATABASE_TESTS",
        "DOCKER_HOST",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "RUN_DEPLOY_COMPOSE_TESTS",
        "RUN_V25_IMAGE_TESTS",
        "RUN_V25_STAGING_TESTS",
        "RUN_V25_ROLLBACK_TESTS",
        "V25_PREVIOUS_API_IMAGE",
        "V25_PREVIOUS_WORKER_IMAGE",
        "V25_PREVIOUS_WEB_IMAGE",
        "V25_API_IMAGE",
        "V25_WEB_IMAGE",
        "WORKER_CONTAINER_IMAGE"
      ],
      "passThroughEnv": [
        "MUSEFOLD_E2E_USERNAME",
        "MUSEFOLD_E2E_PASSWORD",
        "MUSEFOLD_E2E_IMAGE_API_KEY",
        "RUN_DATABASE_TESTS",
        "TWO_DEVICE_RESULTS_DIR",
        "V25_STAGING_EVIDENCE_DIR"
      ],
      "inputs": [
        "package.json",
        "tsconfig*.json",
        "vitest.config.ts",
        "tooling/aliases.mjs",
        "docs/v2.5/V25-EVIDENCE-MANIFEST.json",
        "docs/v2.5/V25-MIGRATION-CARDS.md",
        "apps/desktop/src/**",
        "tests/v25/**",
        "!tests/v25/.results/**",
        "tests/repo/**",
        "scripts/**",
        "infra/**",
        ".github/workflows/**",
        "apps/desktop/electron/**",
        "packages/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@musefold/web-next#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "//#build": {
      "dependsOn": ["@musefold/managed-fs#build"],
      "outputs": ["apps/desktop/out/**"],
      "inputs": [
        "package.json",
        "apps/desktop/electron.vite.config.ts",
        "tooling/aliases.mjs",
        "postcss.config.js",
        "tailwind.config.ts",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/core/**",
        "packages/desktop-contracts/**",
        "packages/desktop-db/**",
        "packages/domain/**",
        "packages/automation-server/**",
        "packages/contracts/**",
        "packages/features/**",
        "packages/new-api-client/**",
        "packages/platform/**",
        "packages/ui/**",
        "packages/update-protocol/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "lint": {},
    "//#lint": {
      "inputs": [
        "package.json",
        "biome.json",
        "tooling/aliases.mjs",
        "apps/desktop/electron.vite.config.ts",
        "vitest.config.ts",
        "vite.preview.config.ts",
        "tailwind.config.ts",
        "postcss.config.js",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "scripts/**",
        "infra/**",
        "preview/**",
        "tests/**",
        "website/Musefold/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "check:boundaries": {},
    "//#check:boundaries": {
      "inputs": [
        "package.json",
        "tooling/dependency-cruiser.cjs",
        "tooling/dependency-cruiser-known-violations.json",
        "apps/desktop/tsconfig.node.json",
        "tooling/tsconfig.base.json",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    }
  }
}
