{
  "$schema": "https://turborepo.dev/schema.json",
  // 远程缓存走 Turborepo 默认:环境里设 TURBO_TOKEN / TURBO_TEAM 即启用,凭据不进本文件。
  // Electron 打包(package / package:mac / package:win)刻意不是 turbo 任务。
  "globalDependencies": [
    "tsconfig*.json",
    "apps/desktop/tsconfig*.json",
    "tooling/tsconfig.base.json",
    "pnpm-workspace.yaml",
    "biome.json"
  ],
  "globalEnv": ["NODE_VERSION"],
  // PORT 只是本地预览端口(vite.preview.config.ts / E2E),不影响构建产物哈希。
  "globalPassThroughEnv": ["PORT"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".tsout/**"],
      "with": ["//#typecheck"]
    },
    "@musefold/web-next#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@musefold/mcp#typecheck": {
      "dependsOn": [
        "@musefold/client#typecheck",
        "@musefold/core#typecheck",
        "@musefold/automation-server#typecheck"
      ],
      "outputs": [".tsout/**"]
    },
    "//#typecheck": {
      "dependsOn": [
        "@musefold/core#typecheck",
        "@musefold/desktop-contracts#typecheck",
        "@musefold/automation-server#typecheck",
        "@musefold/cli#typecheck",
        "@musefold/mcp#typecheck"
      ],
      "outputs": [".tsout/**", "packages/*/.tsout/**", "apps/*/.tsout/**"],
      "inputs": [
        "package.json",
        "tsconfig*.json",
        "apps/desktop/tsconfig*.json",
        "tooling/tsconfig.base.json",
        "docs/v2.5/V25-EVIDENCE-MANIFEST.json",
        "docs/v2.5/V25-MIGRATION-CARDS.md",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "test": {
      "env": ["CI", "MUSEFOLD_TVT_KEY"]
    },
    "//#test": {
      "env": ["CI", "MUSEFOLD_TVT_KEY"],
      "passThroughEnv": [
        "MUSEFOLD_E2E_USERNAME",
        "MUSEFOLD_E2E_PASSWORD",
        "MUSEFOLD_E2E_IMAGE_API_KEY"
      ],
      "inputs": [
        "package.json",
        "tsconfig*.json",
        "vitest.config.ts",
        "tooling/aliases.mjs",
        "docs/v2.5/V25-EVIDENCE-MANIFEST.json",
        "docs/v2.5/V25-MIGRATION-CARDS.md",
        "apps/desktop/src/**",
        "tests/repo/**",
        "apps/desktop/electron/**",
        "packages/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@musefold/web-next#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "//#build": {
      "outputs": ["apps/desktop/out/**"],
      "inputs": [
        "package.json",
        "apps/desktop/electron.vite.config.ts",
        "tooling/aliases.mjs",
        "postcss.config.js",
        "tailwind.config.ts",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/core/**",
        "packages/desktop-contracts/**",
        "packages/desktop-db/**",
        "packages/domain/**",
        "packages/automation-server/**",
        "packages/contracts/**",
        "packages/features/**",
        "packages/new-api-client/**",
        "packages/platform/**",
        "packages/ui/**",
        "packages/update-protocol/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "lint": {},
    "//#lint": {
      "inputs": [
        "package.json",
        "biome.json",
        "tooling/aliases.mjs",
        "apps/desktop/electron.vite.config.ts",
        "vitest.config.ts",
        "vite.preview.config.ts",
        "tailwind.config.ts",
        "postcss.config.js",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "scripts/**",
        "infra/**",
        "preview/**",
        "tests/**",
        "website/Musefold/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "check:boundaries": {},
    "//#check:boundaries": {
      "inputs": [
        "package.json",
        "tooling/dependency-cruiser.cjs",
        "tooling/dependency-cruiser-known-violations.json",
        "apps/desktop/tsconfig.node.json",
        "tooling/tsconfig.base.json",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    }
  }
}
