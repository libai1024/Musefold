{
  "$schema": "https://turborepo.dev/schema.json",
  // Remote cache stays at Turborepo defaults: set TURBO_TOKEN and TURBO_TEAM in the environment to enable. Do not put credentials in this file.
  // Electron packaging (package / package:mac / package:win / electron-builder) is intentionally not a turbo task.
  "globalDependencies": [
    "tsconfig*.json",
    "apps/desktop/tsconfig*.json",
    "tooling/tsconfig.base.json"
  ],
  "globalEnv": ["NODE_VERSION"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".tsout/**"],
      "with": ["//#typecheck"]
    },
    "@musefold/mcp#typecheck": {
      "dependsOn": [
        "@musefold/client#typecheck",
        "@musefold/core#typecheck",
        "@musefold/automation-server#typecheck"
      ],
      "outputs": [".tsout/**"]
    },
    "//#typecheck": {
      "dependsOn": [
        "@musefold/core#typecheck",
        "@musefold/desktop-contracts#typecheck",
        "@musefold/automation-server#typecheck",
        "@musefold/cli#typecheck",
        "@musefold/mcp#typecheck",
        "@musefold/cloud-client#typecheck",
        "@musefold/product-ui#typecheck",
        "@musefold/web#typecheck",
        "@musefold/web-api#typecheck",
        "@musefold/generation-worker#typecheck"
      ],
      "outputs": [".tsout/**", "packages/*/.tsout/**", "apps/*/.tsout/**"],
      "inputs": [
        "package.json",
        "tsconfig*.json",
        "apps/desktop/tsconfig*.json",
        "tooling/tsconfig.base.json",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "test": {
      "env": ["CI", "MUSEFOLD_TVT_KEY"]
    },
    "//#test": {
      "env": ["CI", "MUSEFOLD_TVT_KEY"],
      "inputs": [
        "package.json",
        "vitest.config.ts",
        "tooling/aliases.mjs",
        "apps/desktop/src/**",
        "tests/repo/**",
        "apps/desktop/electron/**",
        "packages/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "//#build": {
      "outputs": ["apps/desktop/out/**"],
      "inputs": [
        "package.json",
        "apps/desktop/electron.vite.config.ts",
        "tooling/aliases.mjs",
        "postcss.config.js",
        "tailwind.config.ts",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/core/**",
        "packages/desktop-contracts/**",
        "packages/domain/**",
        "packages/automation-server/**",
        "packages/cloud-client/**",
        "packages/contracts/**",
        "packages/update-protocol/**",
        "packages/ui/**",
        "packages/product-ui/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "lint": {},
    "//#lint": {
      "inputs": [
        "package.json",
        "eslint.config.mjs",
        "tooling/eslint.config.base.mjs",
        "tooling/aliases.mjs",
        "apps/desktop/electron.vite.config.ts",
        "vitest.config.ts",
        "vite.preview.config.ts",
        "tailwind.config.ts",
        "postcss.config.js",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "scripts/**",
        "infra/**",
        "preview/**",
        "tests/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "check:boundaries": {},
    "//#check:boundaries": {
      "inputs": [
        "package.json",
        "tooling/dependency-cruiser.cjs",
        "tooling/dependency-cruiser-known-violations.json",
        "apps/desktop/tsconfig.node.json",
        "tooling/tsconfig.base.json",
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "packages/**",
        "apps/**",
        "!**/.tsout/**",
        "!**/*.tsbuildinfo"
      ]
    }
  }
}
